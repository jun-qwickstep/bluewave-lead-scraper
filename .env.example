# Copy this file to .env (cp .env.example .env), then paste your keys after the = signs.
# .env stays on your computer. It is listed in .gitignore and never uploaded to GitHub.

# Apify: console.apify.com -> Settings -> API & Integrations -> Personal API token
# (switch to the Blue Wave AI organization first so its card is the one charged)
APIFY_TOKEN=

# MillionVerifier: app.millionverifier.com -> API -> API key
MILLION_VERIFIER_API_KEY=
